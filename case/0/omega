FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1.01;

boundaryField
{
    inlet 
    {
        type            fixedValue;
        value           $internalField;
    }

    upperWall
    {
        type            zeroGradient;     
    }

    lowerWall
    {
        type            omegaWallFunction;
        value           $internalField;
    }
    
    outlet
    {
        type            zeroGradient;
        //type            inletOutlet;
        //inletValue      $internalField;
        //value           $internalField;
    }

    back
    {
        type            zeroGradient;
    }

    front
    {
        type            zeroGradient;
    }

    "cylinder*"
    {
        type            omegaWallFunction;
        value           $internalField;
    }
}


