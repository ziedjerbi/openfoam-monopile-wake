// Correction du gabarit : patches etait ( "sphere*" ), vestige d'un autre cas.
// Le patch cree par snappyHexMesh depuis cylinder.stl s'appelle "cylinder".

forces
{
    type            forces;
    libs            ( "libforces.so" );

    writeControl    timeStep;
    writeInterval   1;

    log             yes;

    patches         ( "cylinder.*" );

    rho             rhoInf;
    rhoInf          1000;

    CofR            (0 0 0);
    pitchAxis       (0 1 0);
}

