FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Retire du gabarit : correctPhi et cellDisplacement, propres aux solveurs
// a maillage mobile (pimpleDyMFoam). Le maillage est fixe ici.

solvers
{
    p
    {
        solver           GAMG;
        tolerance        1e-7;
        relTol           0.01;
        smoother         GaussSeidel;
    }

    pFinal
    {
        $p;
        relTol           0;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-06;
        relTol          0.1;
    }

    "(U|k|omega)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors            2;
    nCorrectors                 1;
    nNonOrthogonalCorrectors    0;
}

relaxationFactors
{
    fields
    {
        p               0.3;
    }
    equations
    {
        "(U|k|omega)"       0.7;
        "(U|k|omega)Final"  1.0;
    }
}

cache
{
    grad(U);
}

