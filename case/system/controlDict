FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Monopieu offshore - echelle modele 1:10 (similitude de Froude)
// U = 0.3162 m/s, d = 0.5 m, domaine 10 x 5 x 2.5 m
// Maillage snappyHexMesh : 642 882 cellules, 0.025 m a la paroi
// CFL : Co = 0.3162 * 0.03 / 0.025 = 0.38

application     pimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         300;

deltaT          0.03;

writeControl    adjustableRunTime;

writeInterval   1;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           1;

maxDeltaT       0.1;

functions
{
    #include "forces"

    yPlus
    {
        type            yPlus;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
    }
}

